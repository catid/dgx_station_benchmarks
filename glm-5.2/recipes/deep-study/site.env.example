# Copy to a private path, edit it for both nodes, and pass SITE_CONFIG=/path/to/file.
# The recipe never configures interfaces or downloads checkpoints/images.
REMOTE_HOST=node1-rail0
REMOTE_STUDY_DIR=/absolute/path/to/dgx_station_benchmarks/glm-5.2/recipes/deep-study
MASTER_ADDR=192.0.2.1
MASTER_PORT=29512
RANK0_IP=192.0.2.1
RANK1_IP=192.0.2.2
FABRIC_IFACE=enP1p3s0f0np0
FABRIC_HCA=mlx5_0
GB300_CUDA_INDEX=REPLACE_WITH_THE_SERVER_GPU_INDEX
MODEL_DIR=/absolute/path/to/models/GLM-5.2-NVFP4
CACHE_ROOT=/absolute/path/to/cache/glm52-deep-study
RESULT_ROOT=/absolute/path/to/results/glm52-deep-study
BENCH_DIR=/absolute/path/to/llm-inference-bench
BENCH_PYTHON=/absolute/path/to/benchmark-venv/bin/python
EVAL_DIR=/absolute/path/to/lm-evaluation-harness
EVAL_PYTHON=/absolute/path/to/eval-venv/bin/python
MAX_IDLE_HBM_MIB=1024
