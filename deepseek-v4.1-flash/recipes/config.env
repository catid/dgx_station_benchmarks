# Shared configuration for serving DeepSeek-V4.1-Flash across node0 (rank 0, API host) and node1 (rank 1).
# Sourced by serve_node.sh / serve_vllm_node.sh / launch_cluster.sh / stop_cluster.sh / status.sh / preflight.sh.
# This is the complete knob list: override any value in the environment, e.g. MODE=low-latency ./launch_cluster.sh.
# Hostnames, SSH aliases, interfaces, and addresses below are examples; substitute your own. $PWD is the recipe
# directory (launch_cluster.sh cd's there before sourcing this file; run the other scripts from it as well).

: "${ENGINE:=sglang}"                              # sglang | vllm  (selects serve_node.sh vs serve_vllm_node.sh and the container name)
: "${IMAGE:=lmsysorg/sglang:dev-dsv41}"          # SGLang DeepSeek-V4.1 preview build (arm64 manifest; see README.md for the measured image id)
: "${VLLM_IMAGE:=vllm/vllm-openai:deepseekv41-flash-0909}"   # vLLM DeepSeek-V4.1 image (arm64 manifest; vllm 0.1.dev20904+g179dd0fa9)
: "${CONTAINER_NAME:=dsv41-$ENGINE}"
: "${SERVED_MODEL_NAME:=DeepSeek-V4.1-Flash}"

# Rank 0 = node0 (API host), rank 1 = node1. Rail 0 carries the torch.distributed bootstrap + NCCL; rail 1 is
# also handed to NCCL for dual-rail collectives. Point-to-point /30 subnets are examples.
: "${RANK0_IP:=192.168.200.1}"                     # node0 rail 0
: "${RANK1_IP:=192.168.200.2}"                     # node1 rail 0
: "${RANK1_RAIL1_IP:=192.168.200.6}"               # node1 rail 1 (preflight jumbo-ping target; empty to skip)
: "${RANK1_SSH:=node1}"                            # ssh alias for rank 1 (BatchMode key auth)
: "${SWAP_RANKS:=0}"                               # 1 -> rank 0 (API host; for vLLM PP the first pipeline stage) runs on the REMOTE node ($RANK1_SSH = node1)
                                                   #      and rank 1 on this host. Used for vLLM: its rank-0 teardown strands HBM on the host it runs on, and only
                                                   #      node1 may be rebooted automatically (tools/ensure_clean_rank1.sh). Rail IPs, model dirs and the API host
                                                   #      swap accordingly (block at the end of this file); clients then use API_URL.
: "${MASTER_PORT:=20000}"                          # --dist-init-addr port
: "${API_PORT:=30000}"
: "${API_HOST:=127.0.0.1}"                        # with SWAP_RANKS=1 the API binds 0.0.0.0 on the remote node and clients use $RANK0_IP (see API_URL)

: "${FABRIC_IFACE:=enP1p3s0f0np0}"                 # rail 0 netdev (GLOO/NCCL bootstrap)
: "${NCCL_HCAS:=mlx5_0,mlx5_1}"                    # dual-rail RoCE by default; set mlx5_0 for single rail
: "${NCCL_TUNING:=tuned}"                          # tuned = RING/SIMPLE/8ch/4QP striping (measured best on this fabric); auto = NCCL defaults
: "${NCCL_DEBUG_LEVEL:=WARN}"
: "${NCCL_DEBUG_SUBSYS:=INIT,NET}"
: "${HOST_RDMA:=1}"                                # 1 -> bind-mount the host's MOFED rdma-core (libibverbs/libmlx5 + provider) into the container so NCCL can
                                                   #      use the ConnectX-8 Data Direct DMA path instead of the stock rdma-core 50 host path (see README.md)
: "${HOST_RDMA_DIR:=$PWD/hostrdma}"                # staged copies of the host libibverbs.so.1 / libmlx5.so.1 / librdmacm.so.1 (see tools/stage_host_rdma.sh)

# Checkpoint location per node (must contain model.safetensors.index.json and all 48 shards). In the measured
# setup node1 held the local NVMe copy and node0 read the same directory over an NFS export carried on rail 1;
# any local or network path works as long as both ranks see the identical pinned revision.
: "${MODEL_DIR_RANK0:=$PWD/models/DeepSeek-V4.1-Flash}"
: "${MODEL_DIR_RANK1:=$PWD/models/DeepSeek-V4.1-Flash}"
: "${MODEL_NFS_EXPORT:=}"                          # e.g. 192.168.200.6:/models when node0 reads the checkpoint from node1 over rail 1; empty = local copy
: "${MODEL_NFS_MOUNT:=$PWD/models}"                # where tools/after_reboot_node0.sh remounts MODEL_NFS_EXPORT after an operator reboot of node0
: "${CACHE_ROOT:=$PWD/cache}"                      # per-node compiler/JIT caches (local disk on each node)

# Parallelism: one GB300 per node -> TP2 + EP2 across the two nodes (EP tracks TP per the SGLang V4.1 recipe).
: "${TP_SIZE:=2}"
: "${EP_SIZE:=2}"

# Serving profile knobs (prefill-oriented defaults; see ../notes/ for the tuning story).
: "${MODE:=throughput}"                            # throughput (no speculation) | low-latency (DSpark)
: "${MEM_FRACTION_STATIC:=0.80}"                   # 0.85 left ~37 GB headroom and hit allocator OOM warnings at 32K-128K x C16; 0.80 keeps ~50 GB for transient prefill buffers
: "${CONTEXT_LENGTH:=262144}"                      # must exceed 131,073 for the 128K prefill points
: "${CHUNKED_PREFILL_SIZE:=16384}"
: "${MAX_PREFILL_TOKENS:=32768}"
: "${MAX_RUNNING_REQUESTS:=64}"
: "${SWA_BOUNDED_REPLAY:=0}"                       # 1 -> --enable-decoder-swa-bounded-replay (faster prefill, not bit-identical)
: "${PREFILL_GRAPH_BACKEND:=}"                     # e.g. breakable | disabled (empty = SGLang default)
: "${CUDA_GRAPH_MAX_BS_PREFILL:=}"
: "${CUDA_GRAPH_MAX_BS_DECODE:=64}"                # derived default (512) OOMs during decode graph capture on 4x GB300/B300 (sglang#38839)
: "${KV_CACHE_DTYPE:=}"                            # empty = model default
: "${ENGRAM_HOST_TABLE:=1}"                        # SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE (required: 189 GiB of tables do not fit next to weights in 2x GB300 HBM)
: "${ENGRAM_LAYOUT:=private}"                      # SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT; 'shared' is a memfd in one PID namespace and cannot span two hosts
: "${ENGRAM_PIN:=1}"                               # SGLANG_DSV41_ENGRAM_HOST_TABLE_PIN (cudaHostRegister the ~94 GiB shard; 0 = plain ATS mapping)
: "${LANGUAGE_MODEL_ONLY:=0}"                      # --language-model-only is rejected for DeepseekV4ForCausalLM in this build (only MuseGlimmer); leave 0
: "${DISABLE_OVERLAP:=0}"                          # 1 -> --disable-overlap-schedule (workaround for the aarch64 2-node overlap hang, sglang#26454)
: "${ALLREDUCE_FUSION:=off}"                       # off -> --enforce-disable-flashinfer-allreduce-fusion (auto-enable assumes MNNVL on Blackwell; this pair has RoCE only); auto -> leave to SGLang
: "${EXTRA_ARGS:=}"                                # appended verbatim to the engine command line
: "${EXTRA_ENV:=}"                                 # newline-separated KEY=VALUE pairs passed as container env

# vLLM-only knobs (ENGINE=vllm). Pipeline parallel is the default: every two-node result in this repository shows
# PP2 beating TP2 on prefill, and PP keeps both Engram layers (1 and 14) on the first stage with no cross-node traffic.
: "${VLLM_PARALLEL:=pp}"                           # pp (TP1 x PP2) | tp (TP2 x PP1); DSpark requires tp
: "${VLLM_PP_LAYER_PARTITION:=}"                   # e.g. 20,20 (empty = vLLM default even split of the 40 layers; the measured PP2 lane used the default).
                                                   #      With the kv-cache patch below any split works; without it only splits that keep a ratio-2 kv-source
                                                   #      layer on both ranks (14,26 or 8,32) start, at the cost of an unbalanced pipeline.
: "${VLLM_GPU_MEMORY_UTILIZATION:=0.90}"
: "${VLLM_LANGUAGE_MODEL_ONLY:=1}"                 # --language-model-only (text-only; skips the ViT)
: "${VLLM_PREFIX_CACHING:=1}"
: "${VLLM_FLASHINFER_AUTOTUNE:=0}"                 # 0 -> --no-enable-flashinfer-autotune (distributed autotune deadlocks across PP stages in this repository's GLM/Hy3 runs)
: "${VLLM_ASYNC_SCHEDULING:=1}"                    # 0 -> --no-async-scheduling
: "${VLLM_KV_CACHE_DTYPE:=}"                       # empty = model default
: "${VLLM_COMPILATION_CONFIG:=}"                   # e.g. '{"cudagraph_mode":"FULL_AND_PIECEWISE"}'
: "${VLLM_ENFORCE_EAGER:=0}"
: "${VLLM_RUST_FRONTEND:=1}"                       # VLLM_USE_RUST_FRONTEND (recipe default)
: "${VLLM_MASTER_PORT:=29501}"                     # torch.distributed TCPStore port for the vLLM ranks
: "${VLLM_DEEP_GEMM_WARMUP:=relax}"                # skip | relax | full
: "${VLLM_PATCH_PP:=1}"                            # 1 -> bind-mount both patches/vllm/ files over the image (required for PP2 in this build; see patches/vllm/README.md):
                                                   #      deepseek_v4_nvidia_model.py (non-first PP ranks get no input_ids; stock build raises "vision MoE routing
                                                   #      requires input_ids") and kv_cache_utils.py (stage 1 allocated KV tensors for stage-0 layers -> StopIteration)

# Apply the role swap exactly once, even when the remote rank re-sources this file with the swapped values passed in.
: "${SWAP_APPLIED:=0}"
if [[ "$SWAP_RANKS" == 1 && "$SWAP_APPLIED" != 1 ]]; then
  _t="$RANK0_IP"; RANK0_IP="$RANK1_IP"; RANK1_IP="$_t"
  _t="$MODEL_DIR_RANK0"; MODEL_DIR_RANK0="$MODEL_DIR_RANK1"; MODEL_DIR_RANK1="$_t"
  API_HOST=0.0.0.0
  SWAP_APPLIED=1
fi
if [[ "$SWAP_RANKS" == 1 ]]; then API_URL="http://$RANK0_IP:$API_PORT"; else API_URL="http://$API_HOST:$API_PORT"; fi
